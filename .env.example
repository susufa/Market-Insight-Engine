# ============================================================
#  Market Insight Engine – Environment Configuration Template
#  Copy this file to .env and fill in actual values.
#  NEVER commit .env to version control.
# ============================================================

# --- Application ---
MIE_ENV=development          # development | test | production
MIE_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- Server ---
MIE_HOST=127.0.0.1           # Bind address; keep 127.0.0.1 for local-only
MIE_PORT=8000

# --- Data Storage Root (use a non-system drive for large data) ---
MIE_DATA_ROOT=./data         # Absolute or relative path to data root directory

# --- SQLite Metadata DB (resolved relative to MIE_DATA_ROOT if not absolute) ---
MIE_META_DB_PATH=            # Leave empty to use MIE_DATA_ROOT/meta.db

# --- Cache ---
MIE_CACHE_MAX_SIZE=256       # LRU in-memory cache entries (per cache namespace)
MIE_CACHE_TTL_SECONDS=300    # Seconds before a hot-cache entry expires

# --- Data Source: AKShare ---
# AKShare is a public open-source library; no key required by default.
# AKSHARE_PROXY=http://127.0.0.1:7890   # Uncomment if behind a proxy

# --- Data Source: Future third-party paid APIs ---
# DATASOURCE_TUSHARE_TOKEN=
# DATASOURCE_WIND_USERNAME=
# DATASOURCE_WIND_PASSWORD=

# --- Hardware / Resource Limits ---
MIE_MAX_WORKER_THREADS=4     # Background task thread pool size (0 = auto)
MIE_MAX_CPU_PERCENT=75       # Refuse to schedule new tasks above this CPU %

# --- Feature Flags ---
MIE_ENABLE_GPU=false         # Set to true to allow GPU acceleration
