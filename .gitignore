# ============================================================
#  .gitignore – Market Insight Engine
# ============================================================

# --- Sensitive configuration ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.pyo
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
site-packages/

# --- Virtual Environments & Local Cache ---
.venv/
venv/
env/
.cache/
web/.npm-cache/

# --- Test & Coverage Reports ---
reports/
.coverage
htmlcov/
.pytest_cache/

# --- Mypy / Ruff Cache ---
.mypy_cache/
.ruff_cache/

# --- Local Data & model artifacts (never commit) ---
data/

# --- Logs ---
logs/
*.log

# --- Model weights & artifacts ---
src/models/weights/
*.pt
*.pth
*.pkl
*.joblib

# --- Frontend build artifacts ---
web/node_modules/
web/dist/
web/.vite/

# --- Local QA artifacts (browser screenshots / fixtures) ---
docs/FRONTEND_V2/
docs/STEP5_RESPONSIVE_TESTS/
*.screen.png

# --- IDE & OS ---
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
.DS_Store
desktop.ini
